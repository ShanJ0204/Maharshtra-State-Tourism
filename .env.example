# Copy to .env.local and fill in the keys for the engines you want to query.
# Any engine without a key falls back to a clearly-labelled MOCK response so the
# UI and scoring pipeline still work end-to-end.

# Claude (Anthropic) — queried via the official SDK with server-side web search.
ANTHROPIC_API_KEY=
# Optional model override (default: claude-opus-4-8)
ANTHROPIC_MODEL=claude-opus-4-8

# OpenAI / ChatGPT
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Google Gemini (uses Google Search grounding for citations)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Perplexity (returns citations natively)
PERPLEXITY_API_KEY=
PERPLEXITY_MODEL=sonar
